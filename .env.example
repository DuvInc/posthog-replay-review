# PostHog, read only. Create a personal API key at
# https://us.posthog.com/settings/user-api-keys (or eu.posthog.com) with the
# scopes "session_recording:read" and "query:read". Nothing here ever writes.
#
# `lib/posthog.mjs` is the only file that reads these. Copy this file to `.env`:
#
#   cp .env.example .env
#
# A real environment variable always wins over the file.
POSTHOG_API_KEY=phx_your-key-here
POSTHOG_HOST=https://us.posthog.com
# The number in your project URL: https://us.posthog.com/project/<this>/...
POSTHOG_PROJECT_ID=12345

# The models, through OpenRouter (https://openrouter.ai). This one spends money:
# about $0.0003 per session for triage plus analysis, measured. Every paid step
# has --dry-run and --max-usd. `lib/llm.mjs` (chat models) and `lib/jev.mjs`
# (decision models, optional) are the only files that read it. Create it at
# https://openrouter.ai/settings/keys with a credit limit.
OPENROUTER_API_KEY=your-key-here

# Another OpenAI-compatible gateway instead of OpenRouter. Its models must
# accept a JSON schema in `response_format`.
# LLM_BASE_URL=https://your-gateway.example/v1
# LLM_API_KEY=...
